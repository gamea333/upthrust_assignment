# Copy to .env and fill in. Never commit .env.

# Site
PUBLIC_SITE_URL=https://upthrust-assignment-rho.vercel.app

# Google Tag Manager container id (GTM-XXXXXXX)
PUBLIC_GTM_ID=GTM-K7FCMLW3

# Sanity
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Supabase (server only). In Vercel add these to BOTH Production and Preview,
# otherwise /api/subscribe fails on preview deployments.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
