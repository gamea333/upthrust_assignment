---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Privacy Policy — Upthrust Design"
  description="How Upthrust Design handles the email addresses collected through our newsletter signup."
>
  <article class="container-page max-w-2xl py-24">
    <a href="/" class="text-sm underline">
      ← Back to home
    </a>
    <h1 class="mt-6 text-4xl font-semibold tracking-tight">Privacy Policy</h1>
    <div class="mt-8 space-y-4 leading-relaxed text-neutral-700">
      <p>
        When you sign up for our emails we store your email address, the time you signed up and your
        consent. We use it only to send our newsletter and updates about our services.
      </p>
      <p>
        Your data is stored with our database provider in the EU and is never sold or shared. You
        can unsubscribe at any time from any email, or ask us to delete your data by writing to
        hello@upthrust.agency.
      </p>
    </div>
  </article>
</BaseLayout>
