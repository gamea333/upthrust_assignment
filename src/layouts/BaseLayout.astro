---
import '../styles/global.css';
import GoogleTagManager from '../components/GoogleTagManager.astro';
import Seo from '../components/Seo.astro';
import type { ImageRef } from '../lib/content';
import { PUBLIC_GTM_ID } from 'astro:env/client';

interface Props {
  title: string;
  description: string;
  image?: ImageRef;
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, image, jsonLd, noindex } = Astro.props;
const gtmId = /^GTM-[A-Z0-9]+$/.test(PUBLIC_GTM_ID ?? '') ? PUBLIC_GTM_ID : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Marks JS as available before first paint, so JS-only layouts (the horizontal
         services scroll) render straight away instead of flashing the fallback. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <Seo title={title} description={description} image={image} jsonLd={jsonLd} noindex={noindex} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ff4200" />
    <GoogleTagManager />
  </head>
  <body>
    {gtmId && (
      <noscript>
        <iframe
          src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
          title="Google Tag Manager"
          height="0"
          width="0"
          style="display:none;visibility:hidden"
        />
      </noscript>
    )}
    <a
      href="#main"
      class="sr-only-focusable fixed top-4 left-4 z-50 bg-brand px-4 py-2 font-semibold text-paper"
    >
      Skip to content
    </a>
    <slot name="header" />
    <main id="main">
      <slot />
    </main>
    <slot name="footer" />

    <script>
      import '../scripts/reveal';
      import '../scripts/magnetic';
    </script>
  </body>
</html>
