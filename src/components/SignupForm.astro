---
import { getContent } from '../lib/content';

const { footer } = await getContent();

const { signup } = footer;
---

<form
  id="signup"
  class="signup"
  action="/api/subscribe"
  method="post"
  novalidate
  aria-labelledby="signup-title"
  data-signup
>
  <h3 id="signup-title" class="signup-title">
    {signup.title}
  </h3>

  <div class="field" data-field="email">
    <label for="signup-email">Email address</label>
    <div class="input-wrap">
      <input
        id="signup-email"
        name="email"
        type="email"
        autocomplete="email"
        inputmode="email"
        placeholder={signup.placeholder}
        required
        aria-describedby="signup-email-error"
      />
      <svg class="valid-tick" viewBox="0 0 16 16" aria-hidden="true">
        <path d="M3 8.5l3.2 3L13 4.5" />
      </svg>
    </div>
    <p id="signup-email-error" class="error" data-error="email" hidden></p>
  </div>

  <div class="field" data-field="consent">
    <label class="consent">
      <input
        name="consent"
        type="checkbox"
        value="yes"
        required
        aria-describedby="signup-consent-error"
      />
      <span>{signup.consent}</span>
    </label>
    <p id="signup-consent-error" class="error" data-error="consent" hidden></p>
  </div>

  <!-- Spam trap: real users never see or fill this. -->
  <div class="hp" aria-hidden="true">
    <label for="signup-company">Company</label>
    <input id="signup-company" name="company" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <button type="submit" class="submit" data-magnetic>
    <span class="label" data-label>
      {signup.button}
    </span>
    <span class="spinner" aria-hidden="true"></span>
  </button>

  <p class="status" role="status" aria-live="polite" data-status></p>
  <p class="success" data-success hidden tabindex="-1">
    <svg class="success-tick" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="10.5" />
      <path d="M7 12.5l3.2 3.2L17 9" />
    </svg>
    <span>{signup.success}</span>
  </p>
</form>

<script>
  import { initSignupForm } from '../scripts/signup';

  document.querySelectorAll<HTMLFormElement>('[data-signup]').forEach(initSignupForm);
</script>

<style>
  .signup {
    display: grid;
    gap: 1rem;
    max-width: 30rem;
  }

  .signup-title {
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .field {
    display: grid;
    gap: 0.375rem;
  }

  label {
    color: #bdbdbd;
  }

  .input-wrap {
    position: relative;
  }

  input[type='email'] {
    width: 100%;
    padding: 0.75rem 1.75rem 0.75rem 0;
    border: 0;
    border-bottom: 1px solid #555;
    background: transparent;
    color: var(--color-paper);
    font-size: 1rem;
  }

  input[type='email']::placeholder {
    color: #8f8f8f;
  }

  input[type='email']:focus-visible {
    outline-offset: 4px;
    border-bottom-color: var(--color-paper);
  }

  input[aria-invalid='true'] {
    border-bottom-color: #ff7a52;
  }

  /* Small tick at the end of the field once the email looks right. */
  .valid-tick {
    position: absolute;
    right: 0.125rem;
    top: 50%;
    width: 1rem;
    height: 1rem;
    translate: 0 -50%;
    fill: none;
    stroke: var(--color-brand);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 16;
    stroke-dashoffset: 16;
    opacity: 0;
    transition:
      stroke-dashoffset 0.4s var(--ease-out),
      opacity 0.2s;
  }

  .field.is-valid .valid-tick {
    stroke-dashoffset: 0;
    opacity: 1;
  }

  .consent {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.625rem;
    align-items: start;
    line-height: 1.45;
    cursor: pointer;
  }

  .consent input {
    width: 1rem;
    height: 1rem;
    margin-top: 0.125rem;
    accent-color: var(--color-brand);
  }

  .error {
    color: #ff7a52;
    font-size: 0.8125rem;
  }

  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .submit {
    position: relative;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1.25rem;
    background: var(--color-paper);
    color: var(--color-ink);
    font-weight: 700;
    cursor: pointer;
    transition:
      background-color 0.2s,
      color 0.2s,
      transform 0.5s var(--ease-out);
  }

  .submit:hover {
    background: var(--color-brand);
    color: var(--color-paper);
  }

  .submit[disabled] {
    opacity: 0.75;
    cursor: progress;
  }

  /* Loading spinner, only while the request is in flight. */
  .spinner {
    display: none;
    width: 0.875rem;
    height: 0.875rem;
    border: 2px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
  }

  .submit[aria-busy='true'] .spinner {
    display: inline-block;
    animation: spin 0.7s linear infinite;
  }

  @keyframes spin {
    to {
      rotate: 1turn;
    }
  }

  .status:empty {
    display: none;
  }

  .success {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem;
    border: 1px solid var(--color-brand);
    font-size: 1rem;
    font-weight: 600;
  }

  .success-tick {
    flex: none;
    width: 1.75rem;
    height: 1.75rem;
    fill: none;
    stroke: var(--color-brand);
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Success: the box slides in, then the circle and tick draw themselves. */
    .success:not([hidden]) {
      animation: success-in 0.5s var(--ease-out) both;
    }

    .success-tick circle {
      stroke-dasharray: 66;
      stroke-dashoffset: 66;
      animation: draw 0.6s var(--ease-out) 0.15s forwards;
    }

    .success-tick path {
      stroke-dasharray: 16;
      stroke-dashoffset: 16;
      animation: draw 0.35s var(--ease-out) 0.6s forwards;
    }

    /* Invalid field on submit: a short horizontal shake. */
    .field.is-shaking {
      animation: shake 0.4s var(--ease-out);
    }

    @keyframes success-in {
      from {
        opacity: 0;
        translate: 0 0.75rem;
      }
    }

    @keyframes draw {
      to {
        stroke-dashoffset: 0;
      }
    }

    @keyframes shake {
      20%,
      60% {
        translate: -6px 0;
      }
      40%,
      80% {
        translate: 6px 0;
      }
    }
  }

  .signup.is-done .field,
  .signup.is-done .submit {
    display: none;
  }
</style>
