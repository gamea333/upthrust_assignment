---
import { getContent } from '../lib/content';

const { footer } = await getContent();

const { signup } = footer;
---

<form
  id="signup"
  class="signup"
  action="/api/subscribe"
  method="post"
  novalidate
  aria-labelledby="signup-title"
  data-signup
>
  <h3 id="signup-title" class="signup-title">
    {signup.title}
  </h3>

  <div class="field">
    <label for="signup-email">Email address</label>
    <input
      id="signup-email"
      name="email"
      type="email"
      autocomplete="email"
      inputmode="email"
      placeholder={signup.placeholder}
      required
      aria-describedby="signup-email-error"
    />
    <p id="signup-email-error" class="error" data-error="email" hidden></p>
  </div>

  <div class="field">
    <label class="consent">
      <input
        name="consent"
        type="checkbox"
        value="yes"
        required
        aria-describedby="signup-consent-error"
      />
      <span>{signup.consent}</span>
    </label>
    <p id="signup-consent-error" class="error" data-error="consent" hidden></p>
  </div>

  <!-- Spam trap: real users never see or fill this. -->
  <div class="hp" aria-hidden="true">
    <label for="signup-company">Company</label>
    <input id="signup-company" name="company" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <button type="submit" class="submit" data-magnetic>
    {signup.button}
  </button>

  <p class="status" role="status" aria-live="polite" data-status></p>
  <p class="success" data-success hidden tabindex="-1">
    {signup.success}
  </p>
</form>

<script>
  import { initSignupForm } from '../scripts/signup';

  document.querySelectorAll<HTMLFormElement>('[data-signup]').forEach(initSignupForm);
</script>

<style>
  .signup {
    display: grid;
    gap: 1rem;
    max-width: 30rem;
  }

  .signup-title {
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .field {
    display: grid;
    gap: 0.375rem;
  }

  label {
    color: #bdbdbd;
  }

  input[type='email'] {
    width: 100%;
    padding: 0.75rem 0;
    border: 0;
    border-bottom: 1px solid #555;
    background: transparent;
    color: var(--color-paper);
    font-size: 1rem;
  }

  input[type='email']::placeholder {
    color: #8f8f8f;
  }

  input[type='email']:focus-visible {
    outline-offset: 4px;
    border-bottom-color: var(--color-paper);
  }

  input[aria-invalid='true'] {
    border-bottom-color: #ff7a52;
  }

  .consent {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.625rem;
    align-items: start;
    line-height: 1.45;
    cursor: pointer;
  }

  .consent input {
    width: 1rem;
    height: 1rem;
    margin-top: 0.125rem;
    accent-color: var(--color-brand);
  }

  .error {
    color: #ff7a52;
    font-size: 0.8125rem;
  }

  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .submit {
    justify-self: start;
    padding: 0.625rem 1.25rem;
    background: var(--color-paper);
    color: var(--color-ink);
    font-weight: 700;
    cursor: pointer;
    transition:
      background-color 0.2s,
      color 0.2s,
      transform 0.5s var(--ease-out);
  }

  .submit:hover {
    background: var(--color-brand);
    color: var(--color-paper);
  }

  .submit[disabled] {
    opacity: 0.6;
    cursor: progress;
  }

  .status:empty {
    display: none;
  }

  .success {
    padding: 1rem;
    border: 1px solid var(--color-brand);
    font-size: 1rem;
    font-weight: 600;
  }

  .signup.is-done .field,
  .signup.is-done .submit {
    display: none;
  }
</style>
