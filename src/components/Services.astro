---
import { Image, getImage } from 'astro:assets';
import tube from '../assets/images/tube.webp';
import { getContent, imageSource } from '../lib/content';
import { gridBackgroundVars } from '../lib/grid';

// Mobile/tablet: each stacked panel shows its own slice of the tube as a background.
// Desktop: one high-res tube image spans the whole horizontal track (see .tube).
const tubeSm = await getImage({ src: tube, format: 'webp', width: 1600 });
const tubeMd = await getImage({ src: tube, format: 'webp', width: 3840 });
const { services, servicesIntro } = await getContent();
const last = services.length - 1;
const gridVars = await gridBackgroundVars();
---

<section
  id="services"
  class="services"
  aria-labelledby="services-title"
  style={`--tube-sm: url(${tubeSm.src}); --tube-md: url(${tubeMd.src}); --panels: ${services.length}; ${gridVars}`}
  data-services
>
  <h2 id="services-title" class="sr-only">
    {servicesIntro}
  </h2>

  <div class="grid-bg grid-drift" aria-hidden="true" data-grid></div>

  <div class="track" data-track>
    <Image
      src={tube}
      alt=""
      class="tube"
      widths={[3840, 5760, 7680]}
      sizes="400vw"
      loading="lazy"
      decoding="async"
      data-tube
    />

    {services.map((service, i) => (
      <article
        class="panel"
        style={`--pos: ${last ? (i / last) * 100 : 0}%`}
        aria-labelledby={`service-${i}`}
        data-panel
      >
        <div class="panel-inner">
          <p class="eyebrow" aria-hidden="true" data-reveal>
            {servicesIntro}
          </p>
          <h3 id={`service-${i}`} class="title" data-reveal style="--i: 1">
            {service.title}
          </h3>

          <div class="collage" data-reveal="scale" style="--i: 2">
            <div class="collage-frame" data-collage>
              <Image
                {...imageSource(service.image)}
                alt={service.imageAlt}
                widths={[400, 700, 1000]}
                sizes="(min-width: 64rem) 34vw, 92vw"
              />
            </div>
          </div>

          <div class="body" data-reveal style="--i: 3">
            <p class="intro">{service.intro}</p>
            <ul class="bullets">
              {service.bullets.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            {service.note && <p class="note">{service.note}</p>}
            <a href="#signup" class="contact" data-magnetic>
              <span>Contact</span>
              <span class="sr-only"> us about {service.title}</span>
            </a>
          </div>
        </div>
      </article>
    ))}
  </div>

  <!-- Desktop progress through the four panels (decorative; headings carry the content). -->
  <div class="progress" aria-hidden="true">
    <span class="count">
      <span data-count>01</span> / {String(services.length).padStart(2, '0')}
    </span>
    <span class="bar">
      <span data-bar></span>
    </span>
  </div>
</section>

<script>
  // Desktop only: pin the section and scroll the panels sideways, with the grid,
  // tube and collages moving at different speeds for depth.
  // The horizontal layout itself is CSS (see .js .track below) so it paints
  // immediately; this script only adds the pin and the scroll-linked movement.
  import { MOTION_QUERY, whenMotionAllowed } from '../scripts/motion';

  const hasWebGL = () => {
    try {
      return !!document.createElement('canvas').getContext('webgl2');
    } catch {
      return false;
    }
  };

  const section = document.querySelector<HTMLElement>('[data-services]');
  const track = section?.querySelector<HTMLElement>('[data-track]');

  if (section && track) {
    whenMotionAllowed(({ gsap, getLenis }) => {
      gsap.matchMedia().add(MOTION_QUERY, () => {
        const distance = () => track.scrollWidth - section.clientWidth;
        const bar = section.querySelector<HTMLElement>('[data-bar]');
        const count = section.querySelector<HTMLElement>('[data-count]');
        const panelCount = track.querySelectorAll('[data-panel]').length;

        const tween = gsap.to(track, {
          x: () => -distance(),
          ease: 'none',
          scrollTrigger: {
            trigger: section,
            pin: true,
            // Lenis already smooths the scroll, so the panels follow it 1:1.
            scrub: true,
            end: () => `+=${distance()}`,
            invalidateOnRefresh: true,
            onUpdate: (self) => {
              if (bar) bar.style.transform = `scaleX(${self.progress.toFixed(4)})`;
              const index = Math.round(self.progress * (panelCount - 1)) + 1;
              if (count && count.dataset.index !== String(index)) {
                count.dataset.index = String(index);
                count.textContent = String(index).padStart(2, '0');
              }
            },
          },
        });
        const trigger = {
          trigger: section,
          start: () => tween.scrollTrigger!.start,
          end: () => tween.scrollTrigger!.end,
          scrub: true,
          invalidateOnRefresh: true,
        };

        // Background grid drifts slowly the other way: feels far away.
        gsap.to('[data-grid]', {
          x: () => -section.clientWidth * 0.08,
          ease: 'none',
          scrollTrigger: trigger,
        });

        // Tube lags a little behind the panels: sits between the grid and the content.
        gsap.to('[data-tube]', { x: () => distance() * 0.1, ease: 'none', scrollTrigger: trigger });

        // Each collage glides across its panel as the panel passes.
        gsap.utils.toArray<HTMLElement>('[data-collage]').forEach((collage) => {
          gsap.fromTo(
            collage,
            { x: 70 },
            {
              x: -70,
              ease: 'none',
              scrollTrigger: {
                trigger: collage.closest('[data-panel]'),
                containerAnimation: tween,
                start: 'left right',
                end: 'right left',
                scrub: true,
              },
            },
          );
        });

        // Keep keyboard focus visible: tabbing into an off-screen panel scrolls to it.
        const panels = [...track.querySelectorAll<HTMLElement>('[data-panel]')];
        const onFocus = (e: FocusEvent) => {
          const index = panels.findIndex((p) => p.contains(e.target as Node));
          const st = tween.scrollTrigger;
          if (index < 0 || !st) return;
          const y = st.start + (distance() * index) / Math.max(panels.length - 1, 1);
          const lenis = getLenis();
          if (lenis) lenis.scrollTo(y, { immediate: true });
          else window.scrollTo({ top: y, behavior: 'instant' });
        };
        track.addEventListener('focusin', onFocus);

        // Live 3D tube (see src/scripts/tube3d.ts). Loaded only after the visitor
        // starts scrolling and the section is about a screen away, so page-load
        // metrics never include it. If WebGL is missing the image simply stays.
        const tubeImage = section.querySelector<HTMLElement>('[data-tube]');
        let unmountTube: (() => void) | undefined;
        let cancelled = false;
        const near = new IntersectionObserver(
          async ([entry]) => {
            if (!entry.isIntersecting || !tubeImage || !hasWebGL()) return;
            near.disconnect();
            const { mountTube3D } = await import('../scripts/tube3d');
            if (cancelled) return;
            unmountTube = await mountTube3D({
              section,
              image: tubeImage,
              getProgress: () => tween.scrollTrigger?.progress ?? 0,
              addTicker: (fn) => gsap.ticker.add(fn),
              removeTicker: (fn) => gsap.ticker.remove(fn),
            }).catch((error) => {
              console.warn('[tube3d] falling back to the image', error);
              return undefined;
            });
          },
          { rootMargin: '0px 0px 100% 0px' },
        );
        const startWatching = () => near.observe(section);
        window.addEventListener('scroll', startWatching, { once: true, passive: true });

        return () => {
          cancelled = true;
          near.disconnect();
          window.removeEventListener('scroll', startWatching);
          unmountTube?.();
          track.removeEventListener('focusin', onFocus);
        };
      });
    });
  }
</script>

<style>
  .services {
    container-type: inline-size;
    position: relative;
    overflow: hidden;
    color: var(--color-paper);
    background: var(--color-ink);
  }

  /* Warped grid on its own layer, oversized so it can drift without showing edges. */
  .grid-bg {
    position: absolute;
    inset: -8%;
    will-change: transform;
  }

  /* Fade the tube and grid out at the bottom so the section hands over to the FAQ
     instead of ending on a hard cut. */
  .services::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 9rem;
    background: linear-gradient(to bottom, transparent, var(--color-ink));
    pointer-events: none;
  }

  .track {
    position: relative;
  }

  .tube,
  .progress {
    display: none;
  }

  .panel {
    position: relative;
    background-image: var(--tube-sm);
    background-repeat: no-repeat;
    background-size: calc(var(--panels) * 100%) auto;
    background-position: var(--pos) 18%;
  }

  .panel-inner {
    position: relative;
    display: grid;
    gap: 1.25rem;
    padding: 4rem 1rem;
  }

  .eyebrow,
  .title {
    text-shadow: 0 1px 14px rgb(0 0 0 / 0.75);
  }

  .eyebrow {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .title {
    margin-top: -0.75rem;
    font-size: clamp(2.25rem, 9cqw, 4rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .collage-frame {
    overflow: hidden;
    border-radius: 0.75rem;
    box-shadow: 0 1.5rem 4rem rgb(0 0 0 / 0.45);
  }

  .collage img {
    display: block;
    width: 100%;
    height: auto;
    transition: scale 0.8s var(--ease-out);
  }

  .collage-frame:hover img {
    scale: 1.04;
  }

  .body {
    max-width: 34rem;
    /* the tube runs behind the copy; keep it readable */
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.85);
  }

  .intro {
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.35;
  }

  .bullets {
    margin-top: 1.25rem;
    display: grid;
    gap: 0.5rem;
    font-size: 0.9375rem;
  }

  .bullets li {
    position: relative;
    padding-left: 1.25rem;
  }

  .bullets li::before {
    content: '✦';
    position: absolute;
    left: 0;
    color: var(--color-brand);
  }

  .note {
    margin-top: 1rem;
    font-size: 0.875rem;
    font-style: italic;
    color: #d6d6d6;
  }

  /* White button; orange fill sweeps in from the left on hover/focus. */
  .contact {
    display: inline-block;
    margin-top: 1.5rem;
    padding: 0.5rem 0.875rem;
    background: linear-gradient(var(--color-brand), var(--color-brand)) no-repeat left / 0% 100%
      var(--color-paper);
    color: var(--color-brand);
    font-size: 1.25rem;
    font-weight: 700;
    text-transform: uppercase;
    text-shadow: none;
    transition:
      background-size 0.45s var(--ease-out),
      color 0.3s var(--ease-out),
      translate 0.3s var(--ease-out),
      transform 0.5s var(--ease-out);
  }

  .contact:hover,
  .contact:focus-visible {
    background-size: 100% 100%;
    color: var(--color-paper);
    translate: 0 -2px;
  }

  @media (min-width: 48rem) {
    .panel {
      background-image: var(--tube-md);
    }

    .panel-inner {
      grid-template-columns: 1fr 1fr;
      align-items: start;
      gap: 1.5rem 2.5rem;
      padding: 5rem 2rem;
    }

    .eyebrow,
    .title {
      grid-column: 1 / -1;
    }
  }

  /* Matches the Figma panel: 1440 wide. --u is 1/100 of the panel, capped at the
     design width (14.4px) and on short screens, so it never outgrows the viewport. */
  @media (min-width: 64rem) {
    .services {
      --u: min(1cqw, 14.4px, 1.6svh);
    }

    .panel-inner {
      width: calc(100 * var(--u));
      margin-inline: auto;
      grid-template-columns: calc(34 * var(--u)) calc(35 * var(--u));
      column-gap: calc(11 * var(--u));
      padding: calc(9 * var(--u)) 0 calc(8 * var(--u)) calc(5.5 * var(--u));
      padding-left: calc(8.3 * var(--u));
    }

    .eyebrow {
      margin-left: calc(-5.5 * var(--u));
      font-size: max(0.75rem, calc(0.9 * var(--u)));
    }

    .title {
      margin-left: calc(-5.5 * var(--u));
      margin-bottom: calc(3 * var(--u));
      font-size: calc(6.4 * var(--u));
    }

    .intro {
      font-size: max(1rem, calc(1.25 * var(--u)));
    }

    .bullets {
      font-size: max(0.9375rem, calc(1.1 * var(--u)));
    }

    .contact {
      font-size: max(1.25rem, calc(1.6 * var(--u)));
    }
  }

  /* Horizontal layout: desktop with JS and motion allowed. Applied by CSS from the
     first paint (html.js is set inline in the head) so the page doesn't jump when
     GSAP arrives. Without JS or with reduced motion the panels stay stacked. */
  @media (min-width: 64rem) and (prefers-reduced-motion: no-preference) {
    :global(.js) .track {
      display: flex;
      width: calc(var(--panels) * 100cqw);
      height: 100vh;
      will-change: transform;
    }

    :global(.js) .panel {
      flex: 0 0 100cqw;
      display: flex;
      align-items: center;
      background-image: none;
    }

    :global(.js) .progress {
      position: absolute;
      left: 50%;
      bottom: 2.5rem;
      z-index: 2;
      display: flex;
      align-items: center;
      gap: 1rem;
      translate: -50% 0;
      font-size: 0.8125rem;
      font-variant-numeric: tabular-nums;
      letter-spacing: 0.08em;
    }

    :global(.js) .bar {
      position: relative;
      width: 10rem;
      height: 2px;
      background: rgb(255 255 255 / 0.2);
      overflow: hidden;
    }

    :global(.js) .bar > span {
      position: absolute;
      inset: 0;
      background: var(--color-brand);
      transform: scaleX(0);
      transform-origin: left;
    }

    /* One continuous high-res tube behind all panels (same framing the per-panel
       backgrounds used: vertically 30% down the panel). */
    /* Live 3D tube canvas (desktop): covers the pinned screen, behind the panels. */
    :global(.tube-canvas) {
      position: absolute;
      inset: 0 0 auto;
      width: 100%;
      height: 100vh;
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.8s var(--ease-out);
    }

    .services:global(.has-3d) :global(.tube-canvas) {
      opacity: 1;
    }

    /* The image stays in place (the 3D tube reads its position) but is hidden. */
    .services:global(.has-3d) .tube {
      opacity: 0;
      transition: opacity 0.8s var(--ease-out);
    }

    :global(.js) .tube {
      display: block;
      position: absolute;
      left: 0;
      top: 30%;
      width: 100%;
      height: auto;
      max-width: none;
      translate: 0 -30%;
      pointer-events: none;
      will-change: transform;
    }
  }
</style>
