---
import { Image, Picture } from 'astro:assets';
import BoldDesign from '../assets/svg/headline-bold-design.svg';
import Performs from '../assets/svg/headline-performs.svg';
import statue from '../assets/images/statue.png';
import lineart from '../assets/images/hero-lineart.png';
import markCircle from '../assets/images/mark-circle.png';
import markSquiggle from '../assets/images/mark-squiggle.png';
import markUnderline from '../assets/images/mark-underline.png';
import { getContent, imageSource } from '../lib/content';

const { hero, clientLogos } = await getContent();

const lastCapability = hero.capabilities.length - 1;
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="stage">
    <Image
      src={lineart}
      alt=""
      class="lineart"
      widths={[300, 500, 800]}
      sizes="(min-width: 1024px) 40vw, 70vw"
      quality={55}
    />

    <h1 id="hero-title" class="contents">
      <span class="sr-only">{hero.headline}</span>
      <span class="bold" aria-hidden="true">
        <BoldDesign class="headline" />
      </span>
      <span class="performs" aria-hidden="true">
        <Performs class="headline" />
      </span>
    </h1>
    <!-- Decorative: outside the H1 so its text reads "Bold design that performs" -->
    <span class="that" aria-hidden="true">
      That
    </span>

    <Picture
      src={statue}
      alt="Iridescent classical bust"
      class="statue-img"
      pictureAttributes={{ class: 'statue' }}
      formats={['avif', 'webp']}
      widths={[320, 480, 640, 860, 1080]}
      sizes="(min-width: 1024px) 44vw, min(72vw, 26rem)"
      loading="eager"
      fetchpriority="high"
    />

    <p class="note note-left">
      {hero.notes.left.lead}
      <span class="marked">
        {hero.notes.left.marked}
        <span
          class="mark mark-circle"
          aria-hidden="true"
          style={`--mark: url(${markCircle.src})`}
        ></span>
      </span>
    </p>

    <p class="note note-right">
      {hero.notes.right.lead}
      <span class="marked">
        {hero.notes.right.marked}
        <span
          class="mark mark-squiggle"
          aria-hidden="true"
          style={`--mark: url(${markSquiggle.src})`}
        ></span>
      </span>
    </p>

    <ul class="capabilities" aria-label="What we do">
      {hero.capabilities.map((item, i) => (
        <li>
          {i === lastCapability ? (
            <span class="marked">
              {item}
              <span
                class="mark mark-underline"
                aria-hidden="true"
                style={`--mark: url(${markUnderline.src})`}
              ></span>
            </span>
          ) : (
            item
          )}{' '}
          <span aria-hidden="true">·</span>
        </li>
      ))}
    </ul>
  </div>

  <div class="proof">
    <p class="proof-stat" data-reveal>
      <strong>{hero.proof.stat}</strong>
      <span>{hero.proof.label}</span>
    </p>
    <ul class="logos" aria-label="Clients">
      {clientLogos.map((logo, i) => (
        <li data-reveal style={`--i: ${i + 1}`}>
          <Image {...imageSource(logo.image, { height: 40 })} alt={logo.name} class="logo" />
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  // Desktop pointer effects: depth parallax on the hero layers and an orange
  // spotlight on the grid lines that follows the cursor. Position is written to
  // CSS variables once per frame; the CSS does the rest.
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const allowed = window.matchMedia(
    '(min-width: 64rem) and (pointer: fine) and (prefers-reduced-motion: no-preference)',
  );

  if (hero) {
    let frame = 0;
    let last: PointerEvent | null = null;

    const apply = () => {
      frame = 0;
      if (!last) return;
      const rect = hero.getBoundingClientRect();
      const x = last.clientX - rect.left;
      const y = last.clientY - rect.top;
      hero.style.setProperty('--mx', `${x}px`);
      hero.style.setProperty('--my', `${y}px`);
      hero.style.setProperty('--px', ((x / rect.width) * 2 - 1).toFixed(3));
      hero.style.setProperty('--py', ((y / rect.height) * 2 - 1).toFixed(3));
    };

    hero.addEventListener('pointermove', (e) => {
      if (!allowed.matches) return;
      last = e;
      hero.classList.add('has-pointer');
      frame ||= requestAnimationFrame(apply);
    });

    hero.addEventListener('pointerleave', () => {
      hero.classList.remove('has-pointer');
      hero.style.setProperty('--px', '0');
      hero.style.setProperty('--py', '0');
    });
  }

  // Live 3D statue (src/scripts/statue3d.ts). The image is the LCP element and
  // always loads first; the 3D only downloads after the first mouse move, on
  // desktops with a mouse, with motion allowed, WebGL available and data saver
  // off. Lighthouse never moves the mouse, so it never loads during a test.
  const stage = hero?.querySelector<HTMLElement>('.stage');
  const statueImage = hero?.querySelector<HTMLElement>('.statue-img');
  const saveData =
    (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData ===
    true;
  const canWebGL = () => {
    try {
      return !!document.createElement('canvas').getContext('webgl2');
    } catch {
      return false;
    }
  };

  if (stage && statueImage && !saveData) {
    const load = () => {
      if (!allowed.matches || !canWebGL()) return;
      window.removeEventListener('pointermove', load);
      import('../scripts/statue3d')
        .then(({ mountStatue3D }) => mountStatue3D({ stage, image: statueImage }))
        .catch((error) => console.warn('[statue3d] keeping the image', error));
    };
    window.addEventListener('pointermove', load, { passive: true });
  }
</script>

<style>
  /* Desktop is laid out on the Figma frame: 1440 wide, 288px grid cells.
     The stage is a container capped at 1440px (and shorter on short screens),
     so 1cqw = 14.4 design px and positions below are design px / 14.4. */
  .hero {
    --cell: 25vw;
    container-type: inline-size;
    position: relative;
    overflow: hidden;
    background-color: var(--color-paper);
  }

  /* grid lines (::before) and the cursor spotlight (::after, desktop only) */
  .hero::before,
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-size: var(--cell) var(--cell);
    background-position: var(--grid-pos, 0 0);
  }

  .hero::before {
    background-image:
      linear-gradient(to right, var(--color-grid) 1px, transparent 1px),
      linear-gradient(to bottom, var(--color-grid) 1px, transparent 1px);
  }

  .hero::after {
    display: none;
    z-index: 0;
    background-image:
      linear-gradient(to right, rgb(255 66 0 / 0.9) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(255 66 0 / 0.9) 1px, transparent 1px);
    mask-image: radial-gradient(
      circle 20rem at var(--mx, 50%) var(--my, 50%),
      #000 0%,
      transparent 100%
    );
    opacity: 0;
    transition: opacity 0.5s var(--ease-out);
  }

  .hero.has-pointer::after {
    opacity: 1;
  }

  .stage {
    container-type: inline-size;
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-areas:
      'bold bold'
      'art art'
      'perf perf'
      'left right'
      'cap cap';
    align-items: start;
    gap: 0 1rem;
    padding: 6rem 1rem 3rem;
  }

  /* Each headline sits in its own clipping box so it can slide up into view. */
  .bold,
  .performs {
    display: block;
    width: 100%;
    position: relative;
    overflow: hidden;
  }

  .headline {
    display: block;
    width: 100%;
    height: auto;
  }

  .bold {
    grid-area: bold;
    z-index: 1;
    margin-bottom: -6cqw;
  }

  .statue {
    grid-area: art;
    justify-self: center;
    width: min(72cqw, 26rem);
    height: auto;
    position: relative;
    z-index: 2;
  }

  .statue-img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Live 3D statue (desktop): sits exactly over the image, image fades out. */
  .stage :global(.statue-canvas) {
    position: absolute;
    z-index: 2;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.6s var(--ease-out);
  }

  .stage:global(.has-3d) :global(.statue-canvas) {
    opacity: 1;
  }

  .stage:global(.has-3d) .statue-img {
    opacity: 0;
    transition: opacity 0.6s var(--ease-out);
  }

  .performs {
    grid-area: perf;
    z-index: 3;
    margin-top: -8cqw;
  }

  .that {
    grid-area: art;
    align-self: center;
    justify-self: end;
    position: relative;
    z-index: 1;
    margin-right: 2cqw;
    font-family: var(--font-display);
    font-size: min(16cqw, 7.5rem);
    line-height: 1;
    color: var(--color-brand);
    text-transform: uppercase;
  }

  .lineart {
    position: absolute;
    right: -10cqw;
    bottom: 0;
    width: 70cqw;
    height: auto;
    opacity: 0.35;
    pointer-events: none;
  }

  .note,
  .capabilities {
    position: relative;
    z-index: 3;
    font-weight: 700;
    line-height: 1.15;
    text-transform: uppercase;
  }

  .note {
    margin-top: 2rem;
    font-size: 0.875rem;
    max-width: 11ch;
  }

  .note-left {
    grid-area: left;
  }

  .note-right {
    grid-area: right;
    justify-self: end;
  }

  .capabilities {
    grid-area: cap;
    margin-top: 1.5rem;
    font-size: 1.25rem;
  }

  .marked {
    position: relative;
    display: inline-block;
    white-space: nowrap;
  }

  /* Hand-drawn marks are stretched to fit their word, so they're backgrounds
     rather than <img> (a stretched <img> is flagged as a distorted image). */
  .marked .mark {
    position: absolute;
    pointer-events: none;
    background: var(--mark) center / 100% 100% no-repeat;
  }

  .mark-circle {
    left: -12%;
    top: -18%;
    width: 124%;
    height: 136%;
  }

  .mark-squiggle,
  .mark-underline {
    left: 0;
    bottom: -0.3em;
    width: 100%;
    height: 0.3em;
  }

  .proof {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    container-type: inline-size;
    border-top: 1px solid var(--color-grid);
    background: var(--color-paper);
  }

  .proof-stat {
    grid-column: 1 / -1;
    padding: 1.25rem 1rem;
  }

  .proof-stat strong {
    display: block;
    font-size: 2rem;
    line-height: 1;
  }

  .proof-stat span {
    display: block;
    max-width: 16ch;
    margin-top: 0.25rem;
    font-size: 0.75rem;
  }

  /* Phones: an even grid, three per row; a final row of two is centred. */
  .logos {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    align-items: center;
    gap: 1.75rem 1rem;
    padding: 1rem 1rem 2.5rem;
  }

  .logos li {
    grid-column: span 2;
    display: flex;
    justify-content: center;
  }

  .logos li:nth-last-child(2):nth-child(3n + 1) {
    grid-column: 2 / span 2;
  }

  /* Logos sit in black like the design; hovering shows the brand's own colours. */
  /* Each logo fits the same box, so wide and compact marks look balanced. */
  .logo {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 1.375rem;
    filter: brightness(0);
    transition:
      filter 0.4s var(--ease-out),
      scale 0.4s var(--ease-out);
  }

  @media (hover: hover) {
    .logo:hover {
      filter: none;
      scale: 1.08;
    }
  }

  @media (min-width: 48rem) {
    .note {
      font-size: 1.125rem;
    }

    .capabilities {
      font-size: 1.75rem;
    }

    .logos {
      display: flex;
      flex-wrap: nowrap;
      justify-content: space-around;
      gap: 2rem;
    }

    .logos li {
      grid-column: auto;
    }

    .logo {
      height: 1.5rem;
      max-height: none;
    }
  }

  @media (min-width: 64rem) {
    .hero {
      --stage-w: min(100%, 90rem, 160svh);
      --cell: calc(var(--stage-w) / 5);
      --grid-pos: center top;
    }

    .hero::after {
      display: block;
    }

    .stage,
    .proof {
      width: var(--stage-w);
      margin-inline: auto;
    }

    .stage {
      display: block;
      aspect-ratio: 1440 / 1152;
      padding: 0;
    }

    .bold,
    .performs,
    .statue,
    .that,
    .note,
    .capabilities {
      position: absolute;
      margin: 0;
    }

    .bold {
      left: 2.64cqw;
      top: 10.56cqw;
      width: 94.72cqw;
    }

    .statue {
      left: 28.5cqw;
      top: 15cqw;
      width: 44cqw;
    }

    .that {
      left: 56.25cqw;
      top: 38.5cqw;
      font-size: 10cqw;
    }

    .performs {
      left: 10.8cqw;
      top: 62cqw;
      width: 78.5cqw;
    }

    .note-left {
      left: 20.1cqw;
      top: 35.5cqw;
      font-size: 1.55cqw;
    }

    .note-right {
      left: 80.3cqw;
      top: 30cqw;
      font-size: 2.1cqw;
    }

    .capabilities {
      left: 4.9cqw;
      top: 45.4cqw;
      font-size: 2.8cqw;
    }

    .lineart {
      right: 0;
      bottom: auto;
      top: 40cqw;
      width: 40cqw;
      opacity: 0.5;
    }

    .proof {
      grid-template-columns: repeat(5, 1fr);
      min-height: min(14.6cqw, 13.1rem, 23svh);
      border-top-color: var(--color-grid);
    }

    .proof-stat {
      grid-column: auto;
      padding: 2cqw 1.7cqw;
    }

    .proof-stat strong {
      font-size: 3.3cqw;
    }

    .proof-stat span {
      font-size: 0.9cqw;
    }

    .logos {
      grid-column: 2 / -1;
      flex-wrap: nowrap;
      justify-content: space-between;
      padding: 0 3cqw;
    }

    .logo {
      height: 2.2cqw;
    }
  }

  /* ---------- motion ---------- */
  @media (prefers-reduced-motion: no-preference) {
    /* entrance, played once on load */
    :global(.js) .hero::before {
      animation: grid-in 1.4s var(--ease-out) both;
    }

    /* transform-only (GPU) so the large SVG shapes aren't repainted every frame */
    :global(.js) .bold .headline {
      animation: rise-in 1.1s var(--ease-out) 0.1s both;
    }

    :global(.js) .performs .headline {
      animation: rise-in 1.1s var(--ease-out) 0.3s both;
    }

    /* The statue is the LCP image, so it has no entrance animation (Chrome only
       counts it as painted once an entrance finishes). It's there from the first
       frame and the headline animates in around it; then it floats gently. */
    :global(.js) .statue-img {
      animation: float 7s var(--ease-in-out) 1.2s infinite alternate;
    }

    :global(.js) .that {
      animation: slide-up 0.9s var(--ease-out) 0.6s both;
    }

    :global(.js) .note-left {
      animation: fade-up 0.8s var(--ease-out) 0.85s both;
    }

    :global(.js) .note-right {
      animation: fade-up 0.8s var(--ease-out) 0.95s both;
    }

    :global(.js) .capabilities li {
      animation: fade-up 0.8s var(--ease-out) both;
    }

    :global(.js) .capabilities li:nth-child(1) {
      animation-delay: 1s;
    }

    :global(.js) .capabilities li:nth-child(2) {
      animation-delay: 1.1s;
    }

    :global(.js) .capabilities li:nth-child(3) {
      animation-delay: 1.2s;
    }

    /* hand-drawn marks draw themselves in after their words land */
    :global(.js) .marked .mark {
      animation: draw 0.9s var(--ease-in-out) 1.5s both;
    }

    :global(.js) .note-right .marked .mark {
      animation-delay: 1.65s;
    }

    :global(.js) .capabilities .marked .mark {
      animation-delay: 1.8s;
    }

    :global(.js) .lineart {
      animation: lineart-in 2s var(--ease-out) 0.4s both;
    }

    /* pointer parallax (desktop): layers drift by different amounts for depth */
    .bold,
    .performs,
    .statue,
    .that,
    .lineart {
      transition: transform 1.1s var(--ease-out);
    }

    .bold {
      transform: translate3d(calc(var(--px, 0) * 10px), calc(var(--py, 0) * 6px), 0);
    }

    .performs {
      transform: translate3d(calc(var(--px, 0) * -10px), calc(var(--py, 0) * -6px), 0);
    }

    .statue {
      transform: translate3d(calc(var(--px, 0) * -18px), calc(var(--py, 0) * -12px), 0);
    }

    .that {
      transform: translate3d(calc(var(--px, 0) * 24px), calc(var(--py, 0) * 14px), 0);
    }

    .lineart {
      transform: translate3d(calc(var(--px, 0) * -30px), calc(var(--py, 0) * -20px), 0);
    }

    @keyframes grid-in {
      from {
        opacity: 0;
      }
    }

    @keyframes rise-in {
      from {
        translate: 0 105%;
      }
    }

    @keyframes float {
      from {
        transform: translateY(0);
      }
      to {
        transform: translateY(-2.5%);
      }
    }

    @keyframes slide-up {
      from {
        opacity: 0;
        translate: 0 40%;
      }
    }

    @keyframes fade-up {
      from {
        opacity: 0;
        translate: 0 1rem;
      }
    }

    @keyframes draw {
      from {
        clip-path: inset(0 100% 0 0);
      }
      to {
        clip-path: inset(0 0 0 0);
      }
    }

    @keyframes lineart-in {
      from {
        opacity: 0;
        rotate: -6deg;
        scale: 0.95;
      }
    }
  }
</style>
