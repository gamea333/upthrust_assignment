---
import LogoMark from '../assets/svg/logo-mark.svg';
import { getContent } from '../lib/content';
import SignupForm from './SignupForm.astro';
import { gridBackgroundVars } from '../lib/grid';

const { footer } = await getContent();
const [wordLeft, wordRight] = footer.wordmark;
const gridVars = await gridBackgroundVars();
---

<footer class="footer" aria-labelledby="footer-title" style={gridVars}>
  <h2 id="footer-title" class="sr-only">
    Upthrust Design
  </h2>

  <div class="grid-bg grid-drift" aria-hidden="true"></div>

  <p class="wordmark" aria-hidden="true" data-reveal="words">
    <span class="word">
      <span>{wordLeft}</span>
    </span>
    <LogoMark class="mark" />
    <span class="word">
      <span>{wordRight}</span>
    </span>
  </p>

  <div class="columns">
    <div class="sites" data-reveal>
      {footer.sites.map((site) => (
        <div class="site">
          <a href={site.href} class="ext" target="_blank" rel="noopener">
            {site.label}
            <span aria-hidden="true">↗</span>
            <span class="sr-only">(opens in a new tab)</span>
          </a>
          <p>{site.description}</p>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </div>
      ))}
      <p class="tagline">{footer.tagline}</p>
    </div>

    <div class="aside" data-reveal style="--i: 2">
      <SignupForm />

      <ul class="links">
        {footer.sites.map((site) => (
          <li>
            <a href={site.href} class="ext" target="_blank" rel="noopener">
              {site.label}
              <span aria-hidden="true">↗</span>
              <span class="sr-only">(opens in a new tab)</span>
            </a>
          </li>
        ))}
      </ul>

      <ul class="social" aria-label="Social">
        {footer.social.map((item, i) => (
          <li>
            <a href={item.href} target="_blank" rel="noopener">
              {item.label}
            </a>
            {i < footer.social.length - 1 && <span aria-hidden="true">,</span>}
          </li>
        ))}
      </ul>

      <div class="legal">
        <a href={footer.legal.privacyHref}>{footer.legal.privacyLabel}</a>
        <p>{footer.legal.copyright}</p>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    container-type: inline-size;
    position: relative;
    overflow: hidden;
    background: var(--color-ink);
    color: var(--color-paper);
    font-size: 0.8125rem;
  }

  .wordmark {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 0.5cqw;
    padding: min(12cqw, 10rem) 1rem min(3cqw, 2.7rem);
    font-family: var(--font-display);
    font-size: min(14cqw, 12.6rem);
    line-height: 0.85;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .mark {
    width: min(4.2cqw, 3.8rem);
    height: auto;
    margin-bottom: max(-1.5cqw, -1.35rem);
    flex: none;
  }

  .columns {
    display: grid;
    max-width: 90rem;
    margin-inline: auto;
    border-top: 1px solid #333;
  }

  .sites {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-content: start;
    gap: 2rem 1rem;
    padding: 2rem 1rem;
  }

  .site p {
    margin-top: 1.25rem;
    color: #bdbdbd;
  }

  .tagline {
    grid-column: 1 / -1;
    color: #bdbdbd;
  }

  a {
    text-underline-offset: 3px;
  }

  .ext,
  .site a {
    text-decoration: underline;
  }

  a:hover {
    color: var(--color-brand);
  }

  .aside {
    display: grid;
    align-content: start;
    gap: 2rem;
    padding: 2rem 1rem 3rem;
    border-top: 1px solid #333;
  }

  .links,
  .social {
    display: flex;
    gap: 1rem;
  }

  .social {
    gap: 0.25rem;
  }

  .legal {
    display: grid;
    gap: 0.25rem;
    color: #bdbdbd;
  }

  @media (min-width: 48rem) {
    .columns {
      grid-template-columns: 1.5fr 1fr;
    }

    .sites {
      padding: 2rem;
      grid-template-rows: auto 1fr;
    }

    .tagline {
      align-self: end;
    }

    .aside {
      border-top: 0;
      border-left: 1px solid #333;
      padding: 2rem;
    }
  }

  @media (min-width: 64rem) {
    .sites {
      grid-template-columns: 1fr 1fr 1fr;
      min-height: 26rem;
    }

    .tagline {
      grid-column: 1 / -1;
    }
  }

  /* Warped grid on its own layer so it can drift; fades in from the FAQ above
     instead of starting on a hard line. */
  .grid-bg {
    position: absolute;
    inset: -6%;
    background-position: center bottom;
    mask-image: linear-gradient(to bottom, transparent 8%, #000 45%);
    pointer-events: none;
    will-change: transform;
  }

  .wordmark,
  .columns {
    position: relative;
  }

  .word {
    display: inline-block;
    overflow: hidden;
    /* room for Anton's descender-free caps without clipping the baseline */
    padding-bottom: 0.04em;
  }

  .word > span {
    display: inline-block;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Wordmark: each word slides up out of its own mask, the mark pops in after. */
    :global(.js) .wordmark[data-reveal] {
      opacity: 1;
      translate: none;
    }

    :global(.js) .wordmark .word > span {
      translate: 0 105%;
      transition: translate 1.1s var(--ease-out);
    }

    :global(.js) .wordmark .word:last-of-type > span {
      transition-delay: 0.12s;
    }

    :global(.js) .wordmark .mark {
      scale: 0;
      rotate: -90deg;
      transition:
        scale 0.8s var(--ease-out) 0.45s,
        rotate 0.8s var(--ease-out) 0.45s;
    }

    :global(.js) .wordmark.is-in .word > span {
      translate: 0 0;
    }

    :global(.js) .wordmark.is-in .mark {
      scale: 1;
      rotate: 0deg;
    }
  }
</style>
